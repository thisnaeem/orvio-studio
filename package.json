{
  "name": "orvio-studio",
  "version": "0.5.0",
  "private": true,
  "description": "Your tools. Your flow. A growing creative workspace.",
  "main": "electron/main.cjs",
  "author": "Orvio Studio",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "concurrently -k \"npm:dev\" \"wait-on http://127.0.0.1:5188 && electron .\"",
    "dist": "npm run build && electron-builder",
    "test": "node --test tests/*.test.cjs",
    "release:build": "npm run build && electron-builder --mac --win --publish never",
    "mcp": "node mcp/server.mjs",
    "runtime:prepare": "node scripts/bundle-python.cjs"
  },
  "dependencies": {
    "@fontsource-variable/unbounded": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "electron-updater": "^6.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "wait-on": "^8.0.4",
    "zod": "^4.6.5"
  },
  "build": {
    "appId": "com.orvio.studio",
    "productName": "Orvio Studio",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "public/orvio-logo.png",
      "identity": null,
      "extendInfo": {
        "NSCameraUsageDescription": "Use your camera when you start a recording in Orvio Studio.",
        "NSMicrophoneUsageDescription": "Record your microphone when you enable it in Recorder.",
        "NSAudioCaptureUsageDescription": "Capture selected audio when recording your screen."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Orvio-Studio-${version}-Windows-Setup.${ext}"
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "thisnaeem",
        "repo": "orvio-studio",
        "releaseType": "release"
      }
    ],
    "artifactName": "Orvio-Studio-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Orvio Studio",
      "uninstallDisplayName": "Orvio Studio",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "en_US"
      ],
      "displayLanguageSelector": false,
      "menuCategory": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "dmg": {
      "title": "Orvio Studio ${version}",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 180
        },
        {
          "x": 390,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "toolsets": {
      "nsis": "1.2.1"
    },
    "afterPack": "scripts/bundle-python.cjs",
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thisnaeem/orvio-studio.git"
  },
  "homepage": "https://github.com/thisnaeem/orvio-studio"
}
